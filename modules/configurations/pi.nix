{ ... }:
{
  nixpkgs.overlays = [
    (final: prev: {
      pi-coding-agent = prev.pi-coding-agent.overrideAttrs (_: rec {
        version = "1.3.0";

        src = final.fetchFromGitHub {
          owner = "earendil-works";
          repo = "pi";
          tag = "v${version}";
          hash = "sha256-AsutbwnjiwwLkB5tqLW+1GdGZyLmXsU0W+SNdNhJu7U=";
        };

        # The provider model catalog is generated by a network fetch at
        # build time and gitignored upstream; restore it from the
        # published pi-ai release matching `version`.
        modelData = final.fetchurl {
          url = "https://registry.npmjs.org/@earendil-works/pi-ai/-/pi-ai-${version}.tgz";
          hash = "sha256-U0PhY5vzQ73DNE3zrWwxwFpQtoutB6xrzhCJDUtrimE=";
        };

        npmDepsHash = "sha256-+gFyvrhkCsF99oNvs0gBmLXnDW0hWnZI/wFId7UbI6Q=";

        # buildNpmPackage resolves the deps fetcher eagerly, so npmDeps
        # must be overridden together with npmDepsHash.
        npmDeps = final.fetchNpmDeps {
          name = "pi-coding-agent-${version}-npm-deps";
          inherit src;
          hash = npmDepsHash;
        };

        # Workspace deps to replace with built copies; must match the
        # workspace set shipped by this release (the nixpkgs list names
        # workspaces removed in 1.3.0).
        postInstall = ''
          local nm="$out/lib/node_modules/pi-monorepo/node_modules"

          for ws in @earendil-works/chord:packages/chord \
                    @earendil-works/pi-ai:packages/ai \
                    @earendil-works/pi-agent-core:packages/agent \
                    @earendil-works/pi-codemode:packages/codemode \
                    @earendil-works/pi-mcp:packages/mcp \
                    @earendil-works/pi-telemetry:packages/telemetry \
                    @earendil-works/pi-tui:packages/tui; do
            IFS=: read -r pkg src <<< "$ws"
            rm "$nm/$pkg"
            cp -r "$src" "$nm/$pkg"
          done

          find "$nm" -type l -lname '*/packages/*' -delete
          find "$nm/.bin" -xtype l -delete
        ''
        + final.lib.optionalString final.stdenvNoCC.hostPlatform.isDarwin ''
          rm -rf \
            "$nm/@anthropic-ai/sandbox-runtime/dist/vendor/seccomp" \
            "$nm/@anthropic-ai/sandbox-runtime/vendor/seccomp"
        '';
      });
    })
  ];

  home-manager.sharedModules = [
    (
      {
        config,
        lib,
        pkgs,
        ...
      }:
      let
        agentDir = config.programs.pi-coding-agent.configDir;
      in
      {
        programs.pi-coding-agent = {
          keybindings = {
            "app.editor.external" = "alt+e";
          };

          settings = {
            packages = [
              "npm:@juicesharp/rpiv-todo"
              "npm:@narumitw/pi-btw"
              "npm:@narumitw/pi-caffeinate"
              "npm:@narumitw/pi-usage"
              "npm:@raidou/pi-notify"
              "npm:@zigai/pi-status-bar"
              "npm:pi-lens"
              "npm:pi-notify"
              "npm:pi-simplify"
              "npm:pi-vim"
            ];

            defaultProvider = "mistral";
            defaultModel = "mistral-large-4";
            enabledModels = [
              "mistral/mistral-large-4"
              "mistral/mistral-small-latest"
              "mistral/zai-glm-5-3"
              "opencode-go/deepseek-v4.1-flash"
              "opencode-go/deepseek-v4-pro"
            ];

            showCacheMissNotices = true;
            defaultTools = [ "+codemode" ];

            tuiMode = "regular";
          };

          # For plugin installation
          extraPackages = [
            pkgs.nodejs
            pkgs.pnpm
          ];

          context = ./ai/context.md;
        };

        programs.git.ignores = [
          ".ws"
        ];

        home.file = lib.mkIf config.programs.pi-coding-agent.enable {
          "${agentDir}/skills/" = {
            source = ./ai/skills;
            recursive = true;
          };

          "${agentDir}/mcp.json".source = ./ai/mcp.json;
        };
      }
    )
  ];
}
