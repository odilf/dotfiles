{ ... }:
{
  nixpkgs.overlays = [
    (final: prev: {
      pi-coding-agent = prev.pi-coding-agent.overrideAttrs (_: rec {
        version = "1.3.0";

        src = final.fetchFromGitHub {
          owner = "earendil-works";
          repo = "pi";
          tag = "v${version}";
          hash = "sha256-AsutbwnjiwwLkB5tqLW+1GdGZyLmXsU0W+SNdNhJu7U=";
        };

        # The provider model catalog is generated by a network fetch at
        # build time and gitignored upstream; restore it from the
        # published pi-ai release matching `version`.
        modelData = final.fetchurl {
          url = "https://registry.npmjs.org/@earendil-works/pi-ai/-/pi-ai-${version}.tgz";
          hash = "sha256-U0PhY5vzQ73DNE3zrWwxwFpQtoutB6xrzhCJDUtrimE=";
        };

        npmDepsHash = "sha256-+gFyvrhkCsF99oNvs0gBmLXnDW0hWnZI/wFId7UbI6Q=";

        # buildNpmPackage resolves the deps fetcher eagerly, so npmDeps
        # must be overridden together with npmDepsHash.
        npmDeps = final.fetchNpmDeps {
          name = "pi-coding-agent-${version}-npm-deps";
          inherit src;
          hash = npmDepsHash;
        };

        # Workspace deps to replace with built copies; must match the
        # workspace set shipped by this release (the nixpkgs list names
        # workspaces removed in 1.3.0).
        postInstall = ''
          local nm="$out/lib/node_modules/pi-monorepo/node_modules"

          for ws in @earendil-works/chord:packages/chord \
                    @earendil-works/pi-ai:packages/ai \
                    @earendil-works/pi-agent-core:packages/agent \
                    @earendil-works/pi-codemode:packages/codemode \
                    @earendil-works/pi-mcp:packages/mcp \
                    @earendil-works/pi-telemetry:packages/telemetry \
                    @earendil-works/pi-tui:packages/tui; do
            IFS=: read -r pkg src <<< "$ws"
            rm "$nm/$pkg"
            cp -r "$src" "$nm/$pkg"
          done

          find "$nm" -type l -lname '*/packages/*' -delete
          find "$nm/.bin" -xtype l -delete
        ''
        + final.lib.optionalString final.stdenvNoCC.hostPlatform.isDarwin ''
          rm -rf \
            "$nm/@anthropic-ai/sandbox-runtime/dist/vendor/seccomp" \
            "$nm/@anthropic-ai/sandbox-runtime/vendor/seccomp"
        '';
      });
    })
  ];

  home-manager.sharedModules = [
    (
      {
        config,
        lib,
        pkgs,
        ...
      }:
      let
        agentDir = config.programs.pi-coding-agent.configDir;
      in
      {
        programs.pi-coding-agent = {
          keybindings = {
            "app.editor.external" = "alt+e";
          };

          settings = {
            packages = [
              "npm:@juicesharp/rpiv-todo"
              "npm:@narumitw/pi-btw"
              "npm:@narumitw/pi-caffeinate"
              "npm:@narumitw/pi-usage"
              "npm:@raidou/pi-notify"
              "npm:@zigai/pi-status-bar"
              "npm:pi-lens"
              "npm:pi-notify"
              "npm:pi-simplify"
              "npm:pi-vim"
            ];

            defaultProvider = "mistral";
            defaultModel = "mistral-large-4";
            enabledModels = [
              "mistral/mistral-large-4"
              "mistral/mistral-small-latest"
              "opencode-go/deepseek-v4.1-flash"
              "opencode-go/deepseek-v4-pro"
            ];

            showCacheMissNotices = true;
            defaultTools = [ "+codemode" ];

            tuiMode = "regular";
          };

          # For plugin installation
          extraPackages = [
            pkgs.nodejs
            pkgs.pnpm
          ];

          context = ''
            ## Disagreement
            Treat a disagreement with my stated goals, constraints, or decisions as useful
            information, not friction to smooth over. Raise it as soon as you notice it,
            rather than spending time trying to reconcile it privately or acting on an
            interpretation I haven't confirmed. Briefly explain what seems inconsistent,
            why it matters, and what you recommend. Don't conceal a concern or silently
            reinterpret my direction. If the disagreement blocks only part of the work,
            flag that part and continue with anything else that can safely proceed.

            ## Comments
            Default to no comment. When one's needed, state the contract (what's
            promised), not the mechanism (how it's built) — and make sure it'd read
            the same for any caller, not just the one in front of you. Never explain
            implementation, name a specific caller/ticket/date, or narrate a decision
            inline; that goes in docs instead. Full standard: ~/.pi/agent/skills/code-comments/SKILL.md

            ## Git
            Never create commits. `git commit`, amend, rebase, cherry-pick, and
            anything else that writes history require explicit permission each time.
            Leave changes in the working tree for me to review and commit myself.

            Inside a jj linked workspace (`.ws/<name>`) git operates on the main
            checkout, not the workspace: there is no workspace-local `.git` and
            `.ws` is globally ignored. Use `jj` (`jj st`, `jj diff`, `jj log`) to
            inspect or track changes there.

            ## Tools
            When a tool is missing or you need one, the first choice is the nixpkgs
            version: `nix run nixpkgs#<name>` to run it once, or `nix shell
            nixpkgs#<name>` to get it in a shell. Prefer these over installing
            anything or reaching for a language-native package manager.
          '';
        };

        programs.git.ignores = [
          ".ws"
        ];

        home.file = lib.mkIf config.programs.pi-coding-agent.enable {
          "${agentDir}/skills/" = {
            source = ./ai/skills;
            recursive = true;
          };

          "${agentDir}/prompts/discuss.md".source = ./ai/discuss.md;
          "${agentDir}/mcp.json".source = ./ai/mcp.json;
        };
      }
    )
  ];
}
