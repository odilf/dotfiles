Upstream binds the single-instance socket through interprocess' namespaced name
type, which on every non-Linux platform resolves to a hardcoded `/tmp/<name>`
path, while the stale-socket cleanup uses `std::env::temp_dir()` (`$TMPDIR` on
macOS). The two disagree, so a socket left behind by an exited editor is never
removed: every later instance fails to bind, silently degrades to the replica
path, and never reaches Discord again.

Use the filesystem name so binding, connecting and cleanup all resolve to the
same path.

--- a/src/discord_rpc.rs
+++ b/src/discord_rpc.rs
@@ -3,7 +3,7 @@
     activity::{self, Activity, Assets, Timestamps},
 };
 use interprocess::local_socket::{
-    GenericFilePath, GenericNamespaced, ListenerOptions, Name, ToFsName, prelude::*,
+    GenericFilePath, ListenerOptions, Name, ToFsName, prelude::*,
 };
 use rkyv::{Archive, Deserialize, Serialize, rancor::Error};
 use std::sync::mpsc::{self, Receiver, Sender};
@@ -397,22 +397,16 @@
     }
 
     fn get_socket_name<'a>() -> Name<'a> {
-        if GenericNamespaced::is_supported() {
-            SOCKET_BASE_NAME.to_ns_name::<GenericNamespaced>().unwrap()
-        } else {
-            std::env::temp_dir()
-                .join(SOCKET_BASE_NAME)
-                .to_string_lossy()
-                .to_string()
-                .to_fs_name::<GenericFilePath>()
-                .unwrap()
-        }
+        std::env::temp_dir()
+            .join(SOCKET_BASE_NAME)
+            .to_string_lossy()
+            .to_string()
+            .to_fs_name::<GenericFilePath>()
+            .unwrap()
     }
 
     fn cleanup_stale_socket() {
-        if !GenericNamespaced::is_supported() {
-            let path = std::env::temp_dir().join(SOCKET_BASE_NAME);
-            let _ = std::fs::remove_file(path);
-        }
+        let path = std::env::temp_dir().join(SOCKET_BASE_NAME);
+        let _ = std::fs::remove_file(path);
     }
 }
