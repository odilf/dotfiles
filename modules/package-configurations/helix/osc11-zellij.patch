# Why this patch exists:
#
# zellij intercepts OSC11 background queries and answers from a stale cache
# (zellij-org/zellij#3590; improved in 0.44.2) and renders panes without terminal
# transparency (zellij-org/zellij#5175). Helix queries the background at startup
# and re-emits the queried color when the theme has no explicit background
# (helix#15527), which repaints the pane with an opaque color under zellij and
# breaks transparent backgrounds. vim never emits OSC11, which is why it works.
#
# This mirrors the existing tmux workaround in helix (commit 3d68e0a32,
# helix-tui/src/backend/termina.rs) for zellij.
#
# TODO: remove when upstream helix adds zellij to that check, or when zellij stops
# intercepting OSC11.
diff --git a/helix-tui/src/backend/termina.rs b/helix-tui/src/backend/termina.rs
index 7c39cc96c..707685969 100644
--- a/helix-tui/src/backend/termina.rs
+++ b/helix-tui/src/backend/termina.rs
@@ -101,8 +101,10 @@ pub fn new(config: Config) -> io::Result<Self> {
         let mut original_background_color = None;
         let start = Instant::now();
 
-        // HACK: emitting OSC11 / OSC111 seems to break SGR and cause flickering in tmux.
-        capabilities.dynamic_background_color = std::env::var_os("TMUX").is_none();
+        // HACK: emitting OSC11 / OSC111 seems to break SGR and cause flickering in tmux,
+        // and breaks transparent backgrounds in zellij (which caches/misreports OSC11).
+        capabilities.dynamic_background_color =
+            std::env::var_os("TMUX").is_none() && std::env::var_os("ZELLIJ").is_none();
 
         capabilities.kitty_keyboard = match config.kitty_keyboard_protocol {
             KittyKeyboardProtocolConfig::Disabled => KittyKeyboardSupport::None,
